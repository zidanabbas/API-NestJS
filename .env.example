# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed origins for CORS. Leave empty to allow all.
CORS_ORIGIN=

# ============================================================
# Database (Postgres)
# ============================================================
# Connection used by Prisma Client at runtime (e.g. via a pooler, IPv4-only)
DATABASE_URL="postgresql://postgres:password@localhost:5432/food_ordering?schema=public"

# Direct connection used for migrations (e.g. session-mode pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/food_ordering?schema=public"

# ============================================================
# Auth (JWT)
# ============================================================
JWT_SECRET=changeme
JWT_EXPIRES_IN=1d

# ============================================================
# Midtrans (Payment Gateway)
# ============================================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "sandbox" untuk testing, "production" untuk live
MIDTRANS_ENV="sandbox"
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/v1/transactions"

# ============================================================
# Store Info (untuk receipt)
# ============================================================
STORE_NAME="Your Store Name"
STORE_ADDRESS="Your Store Address"
STORE_PHONE="08xx-xxxx-xxxx"

# ============================================================
# Webhook (untuk Midtrans notification)
# ============================================================
# Harus accessible dari internet! Gunakan ngrok saat development.
WEBHOOK_BASE_URL="https://your-domain.com"
